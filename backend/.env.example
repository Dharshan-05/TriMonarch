# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (Local PostgreSQL or Supabase PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=erp_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# Optional Supabase / Managed PostgreSQL Connection String:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Authentication Configuration
JWT_SECRET=replace-with-a-secure-secret-key-at-least-32-chars
JWT_ACCESS_SECRET=replace-with-a-secure-access-secret-key-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=trimonarch-erp
JWT_AUDIENCE=trimonarch-api

# API & Security Configuration
CORS_ORIGIN=*
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID,Idempotency-Key
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_CREDENTIALS=true
BODY_LIMIT=1mb
QUERY_PARAMETER_LIMIT=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
GLOBAL_RATE_LIMIT=1000
GLOBAL_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000
SECURITY_HSTS_ENABLED=true
